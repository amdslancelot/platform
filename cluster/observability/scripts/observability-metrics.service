# Host-side textfile metrics producer (image footprint + log sizes). oneshot,
# fired by observability-metrics.timer. Writes .prom files that the in-cluster
# node-exporter DaemonSet exposes via its textfile collector.
#
# Install (see runbook.md): copy both units to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now observability-metrics.timer
# ExecStart paths point at the platform checkout on the node (~opc/platform).
[Unit]
Description=Fleet observability textfile metrics (image + log sizes)
After=k3s.service

[Service]
Type=oneshot
User=root
# Ensure the shared textfile dir exists before either script runs.
ExecStartPre=/usr/bin/mkdir -p /var/lib/node_exporter/textfile_collector
ExecStart=/home/opc/platform/cluster/observability/scripts/image-metrics.sh
ExecStart=/home/opc/platform/cluster/observability/scripts/log-size.sh
